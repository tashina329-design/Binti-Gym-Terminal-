{
  "entities": {
    "GymData": {
      "title": "Gym Data Store",
      "description": "Live synchronized data for sales, attendance, members, staff, shifts, and expenses across all devices",
      "type": "object",
      "properties": {
        "updatedAt": { "type": "number" },
        "deviceId": { "type": "string" },
        "members": { "type": "array" },
        "attendance": { "type": "array" },
        "sales": { "type": "array" },
        "expenses": { "type": "array" },
        "registeredStaff": { "type": "array" },
        "activeShift": { "type": "object" },
        "staffPin": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/gym/{docId}": {
      "schema": { "$ref": "#/entities/GymData" },
      "description": "Central collection for live sync state across devices"
    }
  }
}
